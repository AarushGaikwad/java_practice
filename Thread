
class MyThread extends Thread {
    public void run(){
        System.out.println("Thread is running: " +  Thread.currentThread().getName());
    }
}

class Main {
    public static void main(String[] args) {
        MyThread thread1 = new MyThread();
        thread1.start();
        
        MyThread thread2 = new MyThread();
        thread2.start();
    }
}
