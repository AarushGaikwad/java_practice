abstract class Game {
    static int players = 0;

    Game() {
        players++;
    }

    abstract void play();
}

class Chess extends Game {
    void play() {
        System.out.println("Playing Chess with " + players + " players.");
    }
}

public class Main {
    public static void main(String[] args) {
        Game game1 = new Chess();
        game1.play();

        Game game2 = new Chess();
        game2.play();
    }
}
