//Printing thread 5 times using runnable interface and by extending Thread class

class MyThread extends Thread{
    @Override
    public void run(){
        for(int i=0; i<5; i++){
            System.out.println("thread by extending: " + Thread.currentThread().getName());
        }
    }
}

class ThreadByImplement implements Runnable{
    @Override
    public void run(){
        for(int i=0; i<5; i++){
            System.out.println("thread by implemeting: "+ Thread.currentThread().getName());
        }
    }
}

public class Main {
    public static void main(String[] args) {
        MyThread thread1 = new MyThread();
        ThreadByImplement task = new ThreadByImplement();
        
        Thread thread2 = new Thread(task);
        
        thread1.start();
        thread2.start();
    }
}


//printing the number with the timestamp of 1 sec 
public class Main {
    public static void main(String[] args) {
        Thread thread = new Thread();
        
        for(int i =1; i<=10; i++){
            System.out.println("Number: " + i);
            
            try{
                Thread.sleep(1000);
            }
            catch(Exception e){
                Thread.currentThread().interrupt();
            }
        }
        
        thread.start();
    }
}
