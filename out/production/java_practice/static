class A{
    public static int x;
    
    void show(){
        x=10;
    }
}

public class Main {
    public static void main(String[] args){
        System.out.println("value of x=" + A.x);
        A a = new A();
        a.show();
        System.out.println("value of x=" +  A.x);
        
    } 
}


//A program where static entities are overrided
class Config{
    static String str = "arnav";
    static int id = 2;
    
    Config(){
        str = "Aarush";  //override the value of static string and id
        id = 1;
    }
}

public class Main {
    public static void main(String[] args){
        Config config = new Config();
        System.out.println(Config.str);
        System.out.println(Config.id);
    } 
}
